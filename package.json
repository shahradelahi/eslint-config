{
  "name": "@shahrad/eslint-config",
  "version": "1.1.0",
  "description": "My personal eslint config for eslint, typescript",
  "author": "Shahrad Elahi <shahrad@litehex.com> (https://github.com/shahradelahi)",
  "license": "MIT",
  "repository": "github:shahradelahi/eslint-config",
  "homepage": "https://github.com/shahradelahi/eslint-config#readme",
  "type": "module",
  "engines": {
    "node": "^18.18.0 || ^20.9.0 || >=21.1.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.cjs"
    }
  },
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/**",
    "!**/*.d.cts"
  ],
  "packageManager": "pnpm@10.34.7+sha512.ba98abc585539933375b5971f4bc6d6c73a1b4b7edc4a879e7d102fe5423d1e02309d67c60a11f04955093a96e521ad9c3b138cdd654ca5be563f378b3ae48bd",
  "scripts": {
    "dev": "pnpm build --watch",
    "build": "tsup index.ts --format esm,cjs --dts-resolve --minify",
    "clean": "git clean -xdf \"**/node_modules/**\" dist .tsbuildinfo",
    "typecheck": "tsc --noEmit",
    "lint": "pnpm build && eslint . && pnpm typecheck",
    "prepublishOnly": "pnpm build && pnpm lint"
  },
  "dependencies": {
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/utils": "^8.56.0",
    "typescript-eslint": "^8.56.0"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@shahrad/tsconfig": "^1.2.0",
    "eslint": "^10.0.1",
    "semantic-release": "^24.2.6",
    "tsup": "^8.5.1"
  },
  "private": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "peerDependencies": {
    "eslint": "^9.0.0 || ^10.0.0",
    "typescript": ">=5.0.0"
  }
}
